# Template only — production VITE_API_URL is set directly in Vercel's
# dashboard (Project Settings > Environment Variables > Production), not
# from a committed .env.production file. See DECISIONS.md, 2026-09-16.
#
# Copy this file's shape if setting up a new deployment target; fill in
# the real ApiStack HttpApiEndpoint URL from `cdk deploy ApiStack`'s output.
VITE_API_URL=https://<your-api-id>.execute-api.<region>.amazonaws.com
